# 보안 설정 (필수)
SECRET_KEY='your-secret-key-here-min-32-chars'

# 애플리케이션 설정
DEBUG=true
ENVIRONMENT=development
APP_NAME=지능형 일본 항공권 분석기
VERSION=0.2.0

# Amadeus API 설정 (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_HOSTNAME=test
KOREAEXIM_API_KEY=your_korea_exim_api_key

# 실제 API 사용 여부 (true: 실제 API, false: 더미 데이터)
USE_REAL_AMADEUS=true
ENABLE_DUMMY_FALLBACK=true

# Azure OpenAI 설정
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=4000

# Anthropic 설정
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# 데이터베이스 설정
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
DATABASE_ECHO=false

# Azure Database (운영 환경)
AZURE_DB_HOST=your-server.postgres.database.azure.com
AZURE_DB_NAME=postgres
AZURE_DB_USER=your_db_user
AZURE_DB_PASSWORD=your_db_password
AZURE_DB_PORT=5432
AZURE_DB_SSLMODE=require

# Redis 설정 (캐싱 및 메시지 브로커)
# 로컬 Redis (개발 환경)
#REDIS_URL=redis://localhost:6379/0

# 원격 Redis (운영 환경)
REDIS_URL=redis://default:password@your-redis-host:port
REDIS_HOST=your-redis-host.redns.redis-cloud.com
REDIS_PORT=16186
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Celery 설정 (백그라운드 작업)
CELERY_BROKER_URL=redis://default:password@your-redis-host:port/1
CELERY_RESULT_BACKEND=redis://default:password@your-redis-host:port/2

# 로깅 설정
LOG_LEVEL=INFO

# 보안 설정
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 설정 (운영 환경에서는 반드시 수정 필요)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 개발/테스트 설정
# 테스트 환경에서 사용할 설정들
# TEST_REDIS_URL=redis://localhost:6379/15
# TEST_DATABASE_URL=postgresql+psycopg2://test_user:test_pass@localhost:5432/test_db
