# 환경 설정 예시 파일
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값으로 수정하세요

# ============================================================================
# 보안 설정 (필수)
# ============================================================================
# 64자 이상의 안전한 SECRET_KEY 필요
# 생성 명령: python generate_secret_key.py
SECRET_KEY=your-secret-key-here-minimum-32-characters-required

# ============================================================================
# 애플리케이션 설정
# ============================================================================
DEBUG=true
ENVIRONMENT=development
APP_NAME=지능형 일본 항공권 분석기
VERSION=0.2.0

# ============================================================================
# Amadeus API 설정 (https://developers.amadeus.com)
# ============================================================================
# 실제 API 키로 교체 필요
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_HOSTNAME=test

# 실제 API 사용 여부 (true: 실제 API, false: 더미 데이터)
USE_REAL_AMADEUS=true
ENABLE_DUMMY_FALLBACK=true

# ============================================================================
# Azure OpenAI 설정 (Phase 2에서 사용 예정)
# ============================================================================
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_MAX_TOKENS=4000

# ============================================================================
# 데이터베이스 설정 (향후 확장용)
# ============================================================================
# 로컬 PostgreSQL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/flight_db
DATABASE_ECHO=false

# Azure Database (운영 환경)
AZURE_DB_HOST=your-server.postgres.database.azure.com
AZURE_DB_NAME=postgres
AZURE_DB_USER=your_username
AZURE_DB_PASSWORD=your_password
AZURE_DB_PORT=5432
AZURE_DB_SSLMODE=require

# ============================================================================
# Redis 설정 (캐싱 및 메시지 브로커)
# ============================================================================
# 로컬 Redis
REDIS_URL=redis://localhost:6379/0

# 원격 Redis (운영 환경)
# REDIS_URL=redis://username:password@your-redis-server:6379/0

# ============================================================================
# Celery 설정 (백그라운드 작업)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# 로깅 설정
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# CORS 설정 (Frontend 도메인)
# ============================================================================
# 개발 환경에서는 기본값 사용 (localhost:3000, localhost:8000)
# 운영 환경에서는 실제 도메인으로 수정
# ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ============================================================================
# 보안 설정
# ============================================================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# 개발/테스트 설정
# ============================================================================
# 테스트 환경에서 사용할 설정들
# TEST_REDIS_URL=redis://localhost:6379/15
# TEST_DATABASE_URL=postgresql+psycopg2://test_user:test_pass@localhost:5432/test_db
